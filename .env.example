APP_NAME="PINK \"ME\""
APP_BRAND_NAME="PINK \"ME\""
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Denver

# If MySQL datetime values are stored in UTC, set DB_TIMEZONE=+00:00 so Laravel converts them to APP_TIMEZONE when reading.
# Do not set this if your database already stores local wall-clock times (e.g. Mountain) — times would shift incorrectly.

# When the HTTP document root is the project folder (not Laravel public/), set true for asset() paths like /public/...
# Public disk URLs then use /public/storage/... (requires public/storage symlink — see scripts/deploy-remote.sh).
USE_PUBLIC_URL_PREFIX=false

# Force public disk URLs to /storage/app/public/... when symlinks are not used (unusual on cPanel).
STORAGE_PUBLIC_USE_FULL_PATH=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_PORT=443

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Optional production performance instrumentation
PERFORMANCE_LOG_ENABLED=false
PERFORMANCE_SLOW_REQUEST_MS=800
PERFORMANCE_SLOW_QUERY_MS=120

# Mail: MAIL_MAILER must be "smtp" for live. Patient signup, portal notifications, program-registration guest emails,
# and budget PDF to applicant send synchronously (no worker). Other mail may still use the queue — run: php artisan queue:work
MAIL_MAILER=smtp
MAIL_HOST=mail.portal-pink-me.org
MAIL_PORT=465
MAIL_USERNAME=no-reply@portal.pink-me.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@portal.pink-me.org
MAIL_FROM_NAME="${APP_BRAND_NAME}"
# Send notification/chat mail immediately (recommended on production without a queue worker).
MAIL_SEND_TRANSACTIONAL_SYNC=true

# Optional: enable PHPUnit live SMTP check (tests/Feature/SmtpMailTest.php)
# MAIL_SMTP_TEST=false
# MAIL_SMTP_TEST_RECIPIENT=
# cPanel SSL/TLS: mail.portal-pink-me.org, port 465 (ssl), authenticated SMTP
# If host intercepts SMTP (certificate mismatch): MAIL_VERIFY_PEER=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Stripe: use Test mode keys (pk_test_..., sk_test_...) for sandbox; Live keys for production
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
